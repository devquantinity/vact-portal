# --- Core ---------------------------------------------------------------------------------
DATABASE_URL="postgresql://vact:vact@localhost:5432/vact_portal?schema=public"   # matches docker-compose.yml
APP_URL="http://localhost:3000"            # used in links inside messages; set to the public URL when hosted
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"   # signs the session cookie
UPLOAD_DIR="./uploads"                     # LocalDiskStorage root (Docker volume later)
CRON_SECRET="change-me"                    # Bearer token for POST /api/cron/tick from outside the UI
ALLOWED_DEV_ORIGINS=""                     # extra hosts allowed to open the dev server, e.g. "192.168.0.12,*.ngrok-free.app"

# --- WhatsApp (Meta Cloud API) ----------------------------------------------------------
WHATSAPP_MODE="simulate"                   # live | simulate. simulate = no network call, fake delivered/read
GRAPH_API_VERSION="v24.0"                  # current stable Graph API version
WHATSAPP_PHONE_NUMBER_ID=""                # from Meta app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""                   # temporary (24h) or System User token
WHATSAPP_BUSINESS_ACCOUNT_ID=""            # WABA id (for reference / template management)
WHATSAPP_APP_SECRET=""                     # Meta app secret, validates X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN="vact-verify"        # any string; paste the same value into the webhook setup
WHATSAPP_TEMPLATE_NAME="vact_reminder"     # approved utility template name
WHATSAPP_TEMPLATE_LANGUAGE="en"            # template language code

# --- Email (Resend) ----------------------------------------------------------------------
RESEND_API_KEY=""                          # empty = simulate (no email leaves the machine)
EMAIL_FROM="V ACT Client Portal <onboarding@resend.dev>"   # onboarding@resend.dev works for your own inbox until a domain is verified
RESEND_WEBHOOK_SECRET=""                   # Svix signing secret from the Resend webhook page

# --- Seed (demo logins) --------------------------------------------------------------------
SEED_PASSWORD="Demo1234!"                  # password for every seeded account
SEED_ADMIN_EMAIL="admin@vact.demo"         # admin login; staff become aisyah@ and daniel@ the same domain
SEED_DEMO_EMAIL="client@vact.demo"         # demo client login and inbox (use your own address for live email)
SEED_DEMO_PHONE="+60123456789"             # your own verified WhatsApp number, used for the demo client
